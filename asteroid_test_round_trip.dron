# Asteroid Entity Definition
# Used for parser round-trip validation

[Meta]
type = "entity"
version = "1.0"
author = "jackv"

[Name]
name = "Asteroid-001-MOVED"

[Transform]
x = 240.0
y = 180.0
scaleX = 1.0
scaleY = 1.0
rotation = 90.0

[Sprite]
texture_path = "asteroid_large.png"
clipX = 0
clipY = 0
clipW = 64
clipH = 64

[Render]
visible = true
zLayer = LAYER_DYNAMIC
depthHint = 0.0

[Collision]
shapeType = "Box"
type = "Solid"
response = "Bounce"
elasticity = 0.8
offsetX = 0
offsetY = 0
width = 64
height = 64

[Velocity]
dx = 3.0
dy = -4.0

[Physics]
mass = 10.0
isStatic = false
linearDamping = 0.0

[Tags]
tags = [
    "asteroid",
    "obstacle",
    "large"
]
