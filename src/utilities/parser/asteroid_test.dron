# Asteroid Entity Definition
# Used for parser round-trip validation

[Meta]
type = "entity"
version = "1.0"
author = "jackv"

[Name]
name = "Asteroid-001"

[Transform]
x = 150.0
y = 300.0
scaleX = 1.0
scaleY = 1.0
rotation = 45.0

[Sprite]
texture_path = "asteroid_large.png"
clipX = 0
clipY = 0
clipW = 64
clipH = 64

[Render]
visible = true
zLayer = LAYER_DYNAMIC
depthHint = 0.0

[Collision]
shapeType = "Box"
type = "Solid"
response = "Bounce"
elasticity = 0.8
offsetX = 0
offsetY = 0
width = 64
height = 64

[Velocity]
dx = 1.5
dy = -2.0

[Physics]
mass = 5.0
isStatic = false
linearDamping = 0.0

[Tags]
tags = ["asteroid", "obstacle", "large"]
