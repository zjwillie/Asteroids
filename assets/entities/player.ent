# player.ent — player archetype defaults
# Section header maps to a component. Spawn flow overrides position
# from the level [Ship] block; everything else is the default "a player."

[Name]
name = "Player"

[Transform]
position = { x = 0.0, y = 0.0 }   # overridden by level [Ship] spawn_x / spawn_y
rotation = 0.0

[Velocity]
linearVelocity = { x = 0.0, y = 0.0 }
angularVelocity = 0.0

[Sprite]
width = 10
height = 10
red = 255
green = 100
blue = 100

[Collider]
circle = { radius = 5.0 }

[PlayerControlled]
currently_controllable = true
lives = 3
score = 0
isInvulnerable = false
invulnerableTimer = 0.0