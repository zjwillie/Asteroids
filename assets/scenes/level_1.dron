[Level]
number = 1
name = "Sector 1"

# Per-entity component overrides applied on spawn, keyed by the entity name from
# the scene/level [Entities]. Mirrors the entity's own section/key structure and
# deep-merges over the .ent file — values here win.
[Overrides]
player = {
	Transform = { x = 160.0, y = 90.0 }
}

[Asteroid]
number = 3
distribution = [[0.0, 0.0, 320.0, 180.0]]
exclusion = [[140.0, 70.0, 40.0, 40.0]]
speed = [20.0, 30.0]
